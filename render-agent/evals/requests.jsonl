{"id": "plan-example", "text": "IR view at 10 µm, sun at 40° elevation, from 2 km altitude", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 10, "wavelength_max_um": 10, "sun_elevation_deg": 40, "camera_altitude_m": 2000, "view_elevation_deg": 0, "target_rel_err_percent": null, "assumptions": "nonempty", "is_render_request": true}}
{"id": "window-nadir", "text": "Thermal infrared image over the 8 to 12 micron window from 5 km, looking straight down, 1% uncertainty", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 8, "wavelength_max_um": 12, "camera_altitude_m": 5000, "view_elevation_deg": -90, "target_rel_err_percent": 1, "sun_elevation_deg": null}}
{"id": "sunset-photo", "text": "A colour photo of the sky at sunset from the ground, looking toward the horizon", "expect": {"spectral_mode": "visible", "wavelength_min_um": null, "sun_elevation_deg": {"range": [0, 6]}, "camera_altitude_m": {"range": [0, 10]}, "view_elevation_deg": 0}}
{"id": "zenith-fullhd", "text": "Render the sky in visible light looking straight up, sun at 60 degrees elevation and 90 degrees azimuth, full HD", "expect": {"spectral_mode": "visible", "view_elevation_deg": 90, "sun_elevation_deg": 60, "sun_azimuth_deg": 90, "image_width": 1920, "image_height": 1080}}
{"id": "solar-550nm", "text": "Solar radiance at 550 nm, sun 30° high, camera at 1 km looking 20 degrees below the horizon", "expect": {"spectral_mode": "solar", "wavelength_min_um": {"approx": 0.55, "tol": 0.001}, "wavelength_max_um": {"approx": 0.55, "tol": 0.001}, "sun_elevation_deg": 30, "camera_altitude_m": 1000, "view_elevation_deg": -20}}
{"id": "nm-and-feet", "text": "brightness temperature at 10000 nm from 10,000 ft", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 10, "wavelength_max_um": 10, "camera_altitude_m": {"approx": 3048, "tol": 5}}}
{"id": "quick-band", "text": "Quick preview of the 9.5-10.5 µm band from 2 km, small image", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 9.5, "wavelength_max_um": 10.5, "camera_altitude_m": 2000, "target_rel_err_percent": 5, "image_width": 160, "image_height": 120}}
{"id": "hq-4k-heading", "text": "High quality 4K visible image from 3 km looking at the horizon, heading 270 degrees", "expect": {"spectral_mode": "visible", "target_rel_err_percent": 0.5, "image_width": 3840, "image_height": 2160, "view_azimuth_deg": 270, "camera_altitude_m": 3000, "view_elevation_deg": 0}}
{"id": "wide-budget", "text": "IR view at 11 µm from 2 km, wide angle, under a minute", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 11, "wavelength_max_um": 11, "fov_deg": 90, "time_budget_s": 60}}
{"id": "noon-45-down", "text": "Visible image at noon from 500 m looking 45 degrees down, 0.5 percent error", "expect": {"spectral_mode": "visible", "sun_elevation_deg": {"range": [45, 90]}, "view_elevation_deg": -45, "target_rel_err_percent": 0.5, "camera_altitude_m": 500}}
{"id": "not-a-render", "text": "What is htrdr?", "expect": {"clarification": "nonnull", "is_render_request": false}}
{"id": "sw-band-nadir", "text": "Shortwave band from 0.4 to 0.7 microns, sun at 20 degrees, nadir view from 10 km", "expect": {"spectral_mode": "solar", "wavelength_min_um": 0.4, "wavelength_max_um": 0.7, "sun_elevation_deg": 20, "view_elevation_deg": -90, "camera_altitude_m": 10000}}
{"id": "thermal-zenith-default-band", "text": "Thermal image looking up at the zenith from ground level", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 8, "wavelength_max_um": 12, "view_elevation_deg": 90, "camera_altitude_m": {"range": [0, 10]}, "assumptions": "nonempty"}}
{"id": "square-512", "text": "Make a 512 by 512 picture of the sky from 2 km", "expect": {"spectral_mode": "visible", "image_width": 512, "image_height": 512, "camera_altitude_m": 2000}}
{"id": "all-defaults", "text": "Render something", "expect": {"spectral_mode": "visible", "camera_altitude_m": 1000, "view_elevation_deg": 0, "fov_deg": 60, "image_width": 320, "image_height": 240, "assumptions": "nonempty", "is_render_request": true}}
{"id": "below-4um-is-solar", "text": "IR at 3.9 microns from 1 km", "expect": {"spectral_mode": "solar", "wavelength_min_um": 3.9, "wavelength_max_um": 3.9, "camera_altitude_m": 1000}}
{"id": "nadir-12um-budget", "text": "Nadir view at 12 microns from 20 km, 2% target, 5 minutes max", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 12, "wavelength_max_um": 12, "camera_altitude_m": 20000, "view_elevation_deg": -90, "target_rel_err_percent": 2, "time_budget_s": 300}}
{"id": "low-sun-narrow", "text": "Visible view with a low sun from 1 km, narrow field of view", "expect": {"spectral_mode": "visible", "sun_elevation_deg": {"range": [5, 25]}, "fov_deg": 20, "camera_altitude_m": 1000}}
{"id": "flight-level", "text": "View the horizon at 10 µm from FL350", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 10, "camera_altitude_m": {"approx": 10668, "tol": 100}, "view_elevation_deg": 0}}
{"id": "above-horizon", "text": "Sun at 75 degrees elevation, 120 azimuth, visible, camera at 1.5 km looking 10 degrees above the horizon", "expect": {"spectral_mode": "visible", "sun_elevation_deg": 75, "sun_azimuth_deg": 120, "camera_altitude_m": 1500, "view_elevation_deg": 10}}
