{"id": "dawn-low-altitude", "text": "Picture of the sky at dawn from 300 m up, looking east", "expect": {"spectral_mode": "visible", "wavelength_min_um": null, "sun_elevation_deg": {"range": [0, 10]}, "camera_altitude_m": 300}}
{"id": "fl200-nadir-band", "text": "Thermal IR between 8 and 14 µm looking straight down from FL200", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 8, "wavelength_max_um": 14, "view_elevation_deg": -90, "camera_altitude_m": {"approx": 6096, "tol": 50}}}
{"id": "midday-zenith-colour", "text": "Colour image of the midday sky, camera pointing at the zenith from 1 km", "expect": {"spectral_mode": "visible", "view_elevation_deg": 90, "sun_elevation_deg": {"range": [45, 90]}, "camera_altitude_m": 1000}}
{"id": "half-micron-solar", "text": "Render sunlight at 0.5 micrometres, sun 25 degrees up, from 4 km toward the horizon, 2 percent noise", "expect": {"spectral_mode": "solar", "wavelength_min_um": 0.5, "wavelength_max_um": 0.5, "sun_elevation_deg": 25, "camera_altitude_m": 4000, "view_elevation_deg": 0, "target_rel_err_percent": 2}}
{"id": "feet-and-hd", "text": "HD visible render from 5,000 feet, sun at 50 degrees", "expect": {"spectral_mode": "visible", "image_width": 1280, "image_height": 720, "camera_altitude_m": {"approx": 1524, "tol": 5}, "sun_elevation_deg": 50}}
{"id": "mwir-is-solar", "text": "Infrared view at 3.5 µm from 2 km", "expect": {"spectral_mode": "solar", "wavelength_min_um": 3.5, "wavelength_max_um": 3.5, "camera_altitude_m": 2000}}
{"id": "budget-minutes", "text": "IR at 9 µm from 3 km, give me something within 2 minutes", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 9, "time_budget_s": 120, "camera_altitude_m": 3000}}
{"id": "question-not-render", "text": "How long does a typical htrdr render take?", "expect": {"clarification": "nonnull", "is_render_request": false}}
