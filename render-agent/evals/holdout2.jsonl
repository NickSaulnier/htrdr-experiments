{"id": "hd-sunrise-low", "text": "Give me an HD image of a sunrise as seen from 150 m, looking at the horizon", "expect": {"spectral_mode": "visible", "image_width": 1280, "image_height": 720, "sun_elevation_deg": {"range": [0, 10]}, "camera_altitude_m": 150, "view_elevation_deg": 0}}
{"id": "co2-band-15um", "text": "Brightness temperature in the 14 to 16 micron CO2 band, nadir, from 8 km", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 14, "wavelength_max_um": 16, "view_elevation_deg": -90, "camera_altitude_m": 8000}}
{"id": "near-ir-1um", "text": "Near-infrared at 1.6 µm with the sun 35 degrees up, from 2.5 km", "expect": {"spectral_mode": "solar", "wavelength_min_um": 1.6, "wavelength_max_um": 1.6, "sun_elevation_deg": 35, "camera_altitude_m": 2500}}
{"id": "nm-solar-band", "text": "Shortwave radiance from 400 nm to 1000 nm, camera at 6 km looking 15 degrees down", "expect": {"spectral_mode": "solar", "wavelength_min_um": 0.4, "wavelength_max_um": 1.0, "camera_altitude_m": 6000, "view_elevation_deg": -15}}
{"id": "thermal-noband-quick", "text": "Quick thermal view from a 30 m tower", "expect": {"spectral_mode": "thermal_infrared", "wavelength_min_um": 8, "wavelength_max_um": 12, "camera_altitude_m": 30, "target_rel_err_percent": 5}}
{"id": "fl100-photo", "text": "Photo out of an airliner window at FL100, sun at 30 degrees", "expect": {"spectral_mode": "visible", "camera_altitude_m": {"approx": 3048, "tol": 50}, "sun_elevation_deg": 30}}
{"id": "deg-only-view", "text": "Visible, camera 700 m up, tilted 60 degrees above the horizon, 1024x768", "expect": {"spectral_mode": "visible", "camera_altitude_m": 700, "view_elevation_deg": 60, "image_width": 1024, "image_height": 768}}
{"id": "thanks", "text": "Thanks, that's all for now", "expect": {"clarification": "nonnull", "is_render_request": false}}
